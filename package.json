{
	"name": "better-food-map",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"build:app": "APP_TARGET=capacitor bunx --bun vite build",
		"cap:sync": "bun run build:app && cap sync",
		"cap:open:ios": "cap open ios",
		"cap:open:android": "cap open android",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --incremental",
		"check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --incremental --watch",
		"lint": "oxlint --type-aware && eslint \"**/*.svelte\"",
		"lint:fix": "oxlint --fix && eslint --fix \"**/*.svelte\"",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"deploy": "bun run build && wrangler deploy",
		"db:mcp": "bun run scripts/db-mcp-server.ts",
		"db:pull": "bun run scripts/db-pull.ts",
		"osm:extract": "bun run scripts/osm-extract.ts",
		"overture:enrich": "bun run scripts/overture-enrich.ts",
		"overture:closure-signals": "bun run scripts/overture/closure-signals.ts",
		"test": "bun run paraglide:compile && bun test scripts",
		"d1:migrate": "wrangler d1 migrations apply better-food-map --remote",
		"d1:migrate:local": "wrangler d1 migrations apply better-food-map --local"
	},
	"dependencies": {
		"@capacitor/app": "^8.1.0",
		"@capacitor/browser": "^8.0.3",
		"@capacitor/core": "^8.4.1",
		"@capacitor/preferences": "^8.0.1",
		"@lucide/svelte": "^1.21.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@protomaps/basemaps": "^5.7.2",
		"@valibot/to-json-schema": "^1.7.1",
		"arctic": "^3.7.0",
		"maplibre-gl": "^5.24.0",
		"valibot": "^1.4.1"
	},
	"devDependencies": {
		"@capacitor/android": "^8.4.1",
		"@capacitor/cli": "^8.4.1",
		"@capacitor/ios": "^8.4.1",
		"@cloudflare/workers-types": "^4.20250620.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.20.2",
		"@sveltejs/adapter-cloudflare": "^7.2.5",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^24",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"oxfmt": "^0.52.0",
		"oxlint": "^1.67.0",
		"oxlint-tsgolint": "^0.23.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.7.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"wrangler": "^4.105.0"
	}
}
