# Credentials for talking to the production Cloudflare D1 database from local
# Bun tooling: the MCP server (scripts/db-mcp-server.ts) and the one-shot seed
# script (scripts/seed-d1.ts). The deployed Worker does NOT use these — it reads
# D1 through its `platform.env.DB` binding.
#
# Copy to .env and fill in. Bun auto-loads .env, so the MCP server picks these up.

# Cloudflare account id (Workers & Pages dashboard → Account ID).
CLOUDFLARE_ACCOUNT_ID=

# D1 database id, printed by `wrangler d1 create better-food-map`
# (same value as database_id in wrangler.jsonc).
CLOUDFLARE_DATABASE_ID=

# API token with the "D1 Edit" permission.
# Create at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
