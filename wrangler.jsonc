{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "better-food-map",
	"main": ".svelte-kit/cloudflare/_worker.js",
	// Custom-domain-only: the *.workers.dev URL is disabled.
	"workers_dev": false,
	"compatibility_date": "2025-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	// betterfoodmaps.com is the canonical domain that serves the app. The other
	// hosts (its www, the legacy apex betterfoodmap.com and its www) are routed
	// to this Worker only so src/hooks.server.ts can 301-redirect them to the
	// canonical host before any work is done — custom_domain matches the exact
	// hostname only, so each host that should redirect needs its own route.
	// REDIRECT_HOSTS in src/hooks.server.ts must list every non-canonical
	// pattern here (scripts/redirect.test.ts enforces that).
	"routes": [
		{ "pattern": "betterfoodmaps.com", "custom_domain": true },
		{ "pattern": "www.betterfoodmaps.com", "custom_domain": true },
		{ "pattern": "betterfoodmap.com", "custom_domain": true },
		{ "pattern": "www.betterfoodmap.com", "custom_domain": true }
	],
	// D1 binding consumed by the app via `platform.env.DB`. Fill in `database_id`
	// from `wrangler d1 create better-food-map` (see README "Deploying to
	// Cloudflare"). The same database is the one the MCP server writes to.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "better-food-map",
			"database_id": "81bc57ec-8157-44bb-9959-3764f96a0aa8",
			"migrations_dir": "migrations"
		}
	]
}
