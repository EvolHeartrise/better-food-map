{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "better-food-map",
	"main": ".svelte-kit/cloudflare/_worker.js",
	// Custom-domain-only: the *.workers.dev URL is disabled.
	"workers_dev": false,
	"compatibility_date": "2025-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	// betterfoodmaps.com is the canonical domain that serves the app.
	// betterfoodmap.com is also routed to this Worker but is 301-redirected to the
	// canonical host by src/hooks.server.ts before any work is done.
	"routes": [
		{ "pattern": "betterfoodmaps.com", "custom_domain": true },
		{ "pattern": "betterfoodmap.com", "custom_domain": true }
	],
	// D1 binding consumed by the app via `platform.env.DB`. Fill in `database_id`
	// from `wrangler d1 create better-food-map` (see README "Deploying to
	// Cloudflare"). The same database is the one the MCP server writes to.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "better-food-map",
			"database_id": "81bc57ec-8157-44bb-9959-3764f96a0aa8",
			"migrations_dir": "migrations"
		}
	]
}
