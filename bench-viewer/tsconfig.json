{
	// Standalone from the root tsconfig on purpose: the viewer is a plain
	// Vite + Svelte SPA with no SvelteKit ambient types, no Cloudflare Workers
	// globals, and no Paraglide output. Sharing the root config would drag all
	// three in. It exists as its own project so eslint's typescript projectService
	// can resolve these components (the repo lints `**/*.svelte`) and so
	// `svelte-check` can type-check them.
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		// ES2023 for `toSorted`/`toReversed`, which this code uses throughout to
		// avoid mutating arrays it does not own (and which the shared
		// `scripts/bench/analyze/*` modules, pulled in by these imports, also use).
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		// `bun` for the `bun:test` imports in the co-located *.test.ts files —
		// without it every test file in this project fails to resolve and
		// svelte-check reports noise instead of real drift.
		"types": ["svelte", "vite/client", "bun"],
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
